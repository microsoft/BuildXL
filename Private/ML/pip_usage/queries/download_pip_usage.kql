// @cluster: cbuild
// @database: CloudBuildProd
// WHY: Download bounded DX5071 Pip Usage telemetry for selected training builds.
// WHAT: Parsed per-pip targets, priors, graph features, and stable split assignments.
// CODESYNC: Public/Src/Engine/Scheduler/Tracing/Log.cs (ProcessPipExecutionInfo, DX5071).
set notruncation;
let ids = dynamic([$ids]);
let processWeightStart = coalesce(
    toscalar(cluster('cbuild').database('CloudBuildProd').BuildInfo
    | where tostring(BuildId) in (ids)
    | summarize min(StartTime)),
    datetime($batch_start));
let processWeights = cluster('cbuild').database('CloudBuildProd').DominoMessage
| where PreciseTimeStamp between (processWeightStart .. datetime($batch_end)) and eventNumber == 301
| extend BuildId=tostring(RelatedActivityId)
| where BuildId in (ids)
| project BuildId, PreciseTimeStamp, message
| parse message with * "DX0301: [Pip" PipHash:string ", " * "] Executing process with process weight: " LoggedEffectiveWeight:long " (user-provided weight: " StaticProcessWeight:long ")."
| where isnotempty(PipHash)
| summarize hint.shufflekey=BuildId arg_max(PreciseTimeStamp, LoggedEffectiveWeight, StaticProcessWeight) by BuildId, PipHash;
cluster('cbuild').database('CloudBuildProd').DominoMessage
| where PreciseTimeStamp between (datetime($batch_start) .. datetime($batch_end)) and eventNumber == 5071
| extend BuildId=tostring(RelatedActivityId)
| where BuildId in (ids)
| project BuildId=tostring(RelatedActivityId), PreciseTimeStamp, message
| parse message with * "DX5071: [Pip" PipHash:string ", " PipDescription:string "] NumProcesses: " * ", ExpectedDurationSec: " ExpectedDurationSec:real ", ActualDurationSec: " ActualDurationSec:real ", MaxExpectedDurationSec: " * ", ExpectedProcessorUseInPercents: " ExpectedProcessorUseInPercents:long ", ProcessorUseInPercents: " ProcessorUseInPercents:long ", Weight: " EffectiveWeight:long ", DefaultWorkingSetMb: " * ", ExpectedPeakWorkingSetMb: " ExpectedPeakWorkingSetMb:long ", PeakWorkingSetMb: " PeakWorkingSetMb:long ", ExpectedAverageWorkingSetMb: " ExpectedAverageWorkingSetMb:long ", AverageWorkingSetMb: " AverageWorkingSetMb:long ", ExpectedDiskIOInMB: " * ", ActualDiskIOInMB: " * ", NumFileDependencies: " NumFileDependencies:long ", NumDirectoryDependencies: " NumDirectoryDependencies:long ", NumFileOutputs: " NumFileOutputs:long ", NumDirectoryOutputs: " NumDirectoryOutputs:long ", Machine: " * ", HasHistoricPerfData: " HasHistoricPerfDataText:string "," *
| where isnotempty(PipHash)
| parse message with * ", ExpectedPipUsageSource: " ExpectedPipUsageSource:string "," *
| extend HasHistoricPerfData=tobool(HasHistoricPerfDataText)
| join kind=leftouter hint.strategy=shuffle processWeights on BuildId, PipHash
| extend Weight=iff(EffectiveWeight == 1, 1, coalesce(StaticProcessWeight, EffectiveWeight))
| project-away message, HasHistoricPerfDataText, EffectiveWeight, LoggedEffectiveWeight, StaticProcessWeight, BuildId1, PipHash1, PreciseTimeStamp1